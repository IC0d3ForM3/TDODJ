{
  "name": "danddanny-backend",
  "version": "0.3.0",
  "description": "Node API for Angular frontend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "node scripts/run-sql-migration.cjs",
    "migrate:dungons": "node scripts/run-sql-migration.cjs sql/001_create_dungons_table.sql",
    "migrate:dungons:json": "node scripts/run-sql-migration.cjs sql/002_add_dungons_json_columns.sql",
    "migrate:games": "node scripts/run-sql-migration.cjs sql/003_create_games_table.sql",
    "migrate:treshers": "node scripts/run-sql-migration.cjs sql/004_create_treshers_table.sql",
    "migrate:monsters": "node scripts/run-sql-migration.cjs sql/005_create_monsters_table.sql",
    "migrate:images": "node scripts/run-sql-migration.cjs sql/006_create_images_table.sql",
    "migrate:monsters:image": "node scripts/run-sql-migration.cjs sql/007_add_monsters_imageid.sql",
    "migrate:monsters:treshers": "node scripts/run-sql-migration.cjs sql/008_add_monsters_tresherids.sql",
    "migrate:pcs": "node scripts/run-sql-migration.cjs sql/009_create_pcs_table.sql",
    "migrate:friends": "node scripts/run-sql-migration.cjs sql/014_create_friends_table.sql",
    "migrate:dungons:all": "npm run migrate:dungons && npm run migrate:dungons:json && npm run migrate:games && npm run migrate:treshers && npm run migrate:monsters && npm run migrate:images && npm run migrate:monsters:image && npm run migrate:monsters:treshers && npm run migrate:pcs && npm run migrate:friends"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1046.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "multer": "^1.4.5-lts.2",
    "openai": "^6.37.0",
    "pg": "^8.10.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.5.6",
    "@types/pg": "^8.18.0",
    "sharp": "^0.34.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
